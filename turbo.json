{
  "$schema": "./node_modules/turbo/schema.json",
  "cacheDir": ".turbo/cache",
  "cacheMaxSize": "2GB",
  "noUpdateNotifier": true,
  "tasks": {
    "build:daemon:run": {
      "inputs": [
        "src/**/*.ts",
        "!src/**/*.test.ts",
        "!src/test-support/**",
        "tsconfig.json",
        "tsconfig.build.json",
        "package.json",
        "pnpm-lock.yaml"
      ],
      "outputs": ["dist/**", "!dist/ui/**", "!dist/vendor/**", "!dist/bin/**", "!dist/e2e/**"],
      "outputLogs": "new-only"
    },
    "build:ui:run": {
      "inputs": [
        "ui/**",
        "!ui/**/*.test.ts",
        "!ui/**/*.test.tsx",
        "!ui/**/*.md",
        "src/contract/**/*.ts",
        "!src/contract/**/*.test.ts",
        "tsconfig.json",
        "package.json",
        "pnpm-lock.yaml"
      ],
      "outputs": ["dist/ui/**"],
      "outputLogs": "new-only"
    },
    "build:capture:run": {
      "inputs": ["vendor/**", "!vendor/screen-capture/.build/**", "scripts/build-capture.mjs"],
      "outputs": ["dist/vendor/**", "dist/bin/**"],
      "env": ["DEVELOPER_DIR"],
      "outputLogs": "new-only"
    },
    "build:e2e:run": {
      "dependsOn": ["build:daemon:run"],
      "inputs": [
        "e2e/fake-driver/*.ts",
        "e2e/fake-driver/tsconfig.json",
        "tsconfig.json",
        "package.json",
        "pnpm-lock.yaml"
      ],
      "outputs": ["dist/e2e/**"],
      "outputLogs": "new-only"
    }
  }
}

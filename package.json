{
  "name": "pitlane",
  "version": "1.0.0",
  "description": "Control plane for iOS simulators and Android emulators.",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "bin": {
    "pitlane": "dist/cli/main.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "vitest run src",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "fallow": "fallow",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "fallow": "^3.6.0",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.9.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22"
  }
}

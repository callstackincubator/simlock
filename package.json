{
  "name": "simlock",
  "version": "0.3.0",
  "description": "Control plane for iOS simulators and Android emulators.",
  "keywords": [
    "agents",
    "emulators",
    "simulators"
  ],
  "homepage": "https://github.com/callstackincubator/simlock",
  "bugs": {
    "url": "https://github.com/callstackincubator/simlock/issues"
  },
  "license": "MIT",
  "author": "Szymon Chmal <szymon@chmal.it> (V3RON)",
  "repository": {
    "type": "git",
    "url": "https://github.com/callstackincubator/simlock"
  },
  "bin": {
    "simlock": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "!dist/e2e",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts"
  ],
  "type": "module",
  "exports": {
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "default": "./dist/admin/index.js"
    }
  },
  "scripts": {
    "build": "pnpm run build:daemon && pnpm run build:ui",
    "build:daemon": "tsc -p tsconfig.build.json",
    "build:ui": "vite build ui",
    "build:e2e": "tsc -p e2e/fake-driver/tsconfig.json",
    "dev:ui": "vite ui",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "vitest run --project unit",
    "test:changed": "vitest run --project unit --changed origin/main",
    "test:e2e": "pnpm run build && pnpm run build:e2e && vitest run --project e2e --tags-filter='!slow'",
    "test:e2e:slow": "pnpm run build && pnpm run build:e2e && vitest run --project e2e",
    "test:console": "pnpm run build && pnpm run build:e2e && playwright test",
    "typecheck": "tsc --noEmit && tsc -p ui/tsconfig.json",
    "typecheck:e2e": "pnpm run build && tsc -p e2e/tsconfig.typecheck.json",
    "lint": "oxlint src e2e ui",
    "fallow": "fallow",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepare": "lefthook install",
    "check": "pnpm run typecheck && pnpm run typecheck:e2e && pnpm run lint && pnpm run format:check && pnpm run test",
    "release": "release-it",
    "mutate": "node scripts/mutate.mjs"
  },
  "dependencies": {
    "@hono/node-server": "2.0.10",
    "@hono/zod-validator": "^0.9.1",
    "@modelcontextprotocol/sdk": "1.29.0",
    "hono": "^4.13.5",
    "ws": "8.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@release-it/conventional-changelog": "^11.0.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.13",
    "@types/node": "^26.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "fallow": "^3.6.0",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-is": "^19.3.0",
    "recharts": "^3.10.1",
    "release-it": "^20.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^4.1.10"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "release-it": {
    "git": {
      "requireCleanWorkingDir": true,
      "requireBranch": "main",
      "requireUpstream": true,
      "commitMessage": "chore(release): ${version}",
      "tagName": "v${version}"
    },
    "github": {
      "release": true
    },
    "npm": {
      "publish": false
    },
    "hooks": {
      "before:init": "pnpm check"
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "conventionalcommits"
        },
        "infile": "CHANGELOG.md"
      }
    }
  }
}

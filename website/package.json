{
  "name": "simlock-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --dir .. openapi website/public/openapi.json && astro dev",
    "build": "pnpm --dir .. openapi website/public/openapi.json && astro build",
    "preview": "astro preview",
    "check": "pnpm --dir .. openapi website/public/openapi.json && astro check",
    "og": "node scripts/og.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.3.8",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/starlight": "^0.42.2",
    "astro": "^7.3.3",
    "sharp": "^0.35.4",
    "starlight-llms-txt": "^0.12.0",
    "starlight-openapi": "0.27.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "playwright-core": "^1.62.1",
    "typescript": "~5.9.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18"
  }

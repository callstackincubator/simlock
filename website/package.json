    "@astrojs/starlight": "^0.42.2",
    "astro": "^7.3.3",
    "hast-util-select": "^6.0.4",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-stringify": "^11.0.0",
    "sharp": "^0.35.4",
    "starlight-llm-actions": "0.13.0",
    "starlight-openapi": "0.27.0",
    "unified": "^11.0.5",

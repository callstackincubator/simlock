{
  // This file is JSONC: fallow reads these comments; generic JSON tools may not.
  "$schema": "./node_modules/fallow/schema.json",
  // e2e/*.test.ts files are vitest entry points (not reached by static import from any
  // other source file), and e2e/fake-driver/index.ts is loaded dynamically by the
  // daemon via SIMLOCK_DRIVERS_MODULE (see the CLI reference) -- neither is visible to
  // fallow's static reachability graph without being declared explicitly.
  // The web console is its own entry: Vite loads ui/index.html, which loads ui/src/main.tsx. The
  // browser lane's specs are Playwright entry points, as the e2e tests are vitest's.
  // vitest.mutate.config.ts is named only by stryker.config.mjs (`pnpm mutate`).
  // .agents/scripts/*.mjs are run by node from the hooks, the skills and the merge gate; three of
  // them (budget-guard, comment-lint, test-lint) import from their neighbours (usage, comments).
  // .dependency-cruiser.cycles.mjs is named only by src/lint-rules.test.ts, which runs depcruise
  // with it (ADR 0027).
  // vendor/screen-capture/scripts/unframe.mjs is a diagnostic a person runs by hand against a
  // captured file, the way the .agents scripts are.
  // src/core/usage/read-thread.ts is the entry of the usage read thread, loaded by path from
  // src/core/usage/index.ts (a worker thread, not an import).
  // src/updater/main.ts is the entry of the detached updater process (node runs it by path, from dist/).
  // src/daemon/openapi.ts is read only by scripts/openapi.mjs, from the compiled dist/, so no import
  // reaches it.
  // website/ is its own package (its own package.json, lockfile and pnpm root), built by Astro
  // and deployed to GitHub Pages; nothing in the product imports it.
  "ignorePatterns": ["website/**"],
  // why: tsc's file arguments in the package.json scripts are tsconfig files and the
  // --tsBuildInfoFile caches under node_modules/.cache/tsc, never code that runs, so none is an
  // entry point; without this Fallow warns on every run that it skipped the three caches.
  "ignoreCommandEntries": ["tsc"],
  "entry": [
    "src/cli/main.ts",
    "src/daemon/main.ts",
    "src/updater/main.ts",
    "src/daemon/openapi.ts",
    "src/core/usage/read-thread.ts",
    "e2e/**/*.test.ts",
    "ui/src/main.tsx",
    "e2e/console/*.spec.ts",
    "e2e/real-proxy/*.spec.ts",
    "e2e/real-proxy/global-setup.ts",
    "vitest.mutate.config.ts",
    ".agents/scripts/*.mjs",
    ".dependency-cruiser.cycles.mjs",
    "vendor/screen-capture/scripts/*.mjs"
  ],
  "dynamicallyLoaded": [
    "e2e/fake-driver/index.ts",
    // The command tree names its modules in an `import("./commands/<name>.js")` thunk, so
    // reachability is the tree's job and never a static edge; the tree's own module list is
    // what `lazy-loading.test.ts` and the router tests cover.
    "src/cli/commands/*.ts"
  ],
  // The web console's libraries are bundled into dist/ui at build time and ship as files, so
  // they are dev dependencies on purpose: the package gains no runtime dependency for them.
  "ignoreDependencies": [
    "react",
    "react-dom",
    "@fontsource-variable/geist",
    "@fontsource-variable/geist-mono",
    "recharts",
    "@base-ui/react",
    "@tanstack/react-query",
    "@tanstack/react-table",
    "@tanstack/react-virtual",
    // Recharts' peer dependency: installed for it, never imported by the console itself.
    "react-is",
    // The update e2e (e2e/update/update.e2e.test.ts) runs its binary as a local npm registry.
    "verdaccio"
  ],
  "ignoreDependencyOverrides": [
    // MCP SDK 1.29 transitively requires vulnerable node-server 1.x; lockfile/audit verify this patched override.
    { "package": "@hono/node-server", "source": "pnpm-workspace.yaml" },
    // MCP SDK 1.29 transitively requires vulnerable ip-address <=10.3.0; lockfile/audit verify this patched override.
    { "package": "ip-address", "source": "pnpm-workspace.yaml" }
  ],
  "duplicates": {
    // Hide pair-only clones; focus on widespread copy-paste
    // worth refactoring. Lower to 2 to report every duplicate pair.
    "minOccurrences": 3,
    // e2e/fake-driver/fake-driver.ts intentionally parallels src/core/fake-driver.ts
    // in shape (same Driver interface, same kind of scripted/latency/failure
    // bookkeeping) but serves a different purpose: it runs out-of-process in a daemon
    // spawned by the e2e suite, reads its script from a file re-read per call, and
    // appends a call log -- src/core/fake-driver.ts is in-process only and has none
    // of that. The two are expected to diverge, not be merged; see fallow's own
    // guidance for code-duplication ("leave it duplicated when the similarity is
    // accidental and likely to diverge").
    // why: src/drivers/android/profiles/ holds one data table per emulator profile, the hw.*
    // keys its AVD gets; the tables are meant to look alike, and sharing their common rows
    // would hide which value each profile sets.
    "ignore": ["e2e/fake-driver/fake-driver.ts", "src/drivers/android/profiles/**"]
    // Common additions (uncomment to enable):
    // "ignore": [
    //   "**/lib/**",          // for repos that publish transpiled output to lib/
    //   "**/legacy/**",       // for repos with legacy-build artifacts
    //   "**/__generated__/**", // Relay, GraphQL Code Generator
    //   "**/generated/**"     // OpenAPI, Protobuf codegen
    // ]
  },
  "rules": {
    "unused-dependencies": "warn",
    "stale-suppressions": "error",
    // why: a suppression is a claim that Fallow cannot see a use; the `-- <reason>` says which
    // use, so a reader can check it and a stale one can be judged.
    "require-suppression-reason": "error"
  },
  "health": {
    "thresholdOverrides": [
      {
        "files": [".agents/scripts/*.mjs"],
        "maxCyclomatic": 12,
        "maxCognitive": 15,
        "maxCrap": 156,
        "reason": "Glue scripts for the delivery pipeline: git and transcript walks, option parsing, a Markdown shape check. Their tests spawn them rather than import them and there is no coverage pipeline, so Fallow counts 0% coverage and CRAP is cyclomatic squared plus cyclomatic. Cyclomatic 12 and cognitive 15 are the real limits; maxCrap 156 is the CRAP of a cyclomatic-12 function at 0% coverage (12 * 12 + 12), so CRAP never fails a function the cyclomatic ceiling passes."
      },
      {
        "files": ["src/agent-device/host/agent-device-supervisor.test.ts"],
        "maxCrap": 80,
        "reason": "The supervisor's test arranges a process table, a clock, a filesystem and a scripted runner in one helper so each of its cases reads as one claim; the helper is branching setup, not logic under test."
      },
      {
        "files": ["src/drivers/android/screen/session.test.ts"],
        "maxCrap": 45,
        "reason": "The capture's `setup` builds both devices' worlds — two targets, a scripted runner, an adb server, a clock, a filesystem, an optional scripted screen answer — in one helper so each case reads as one claim; the branches are optional arrangement, not logic under test."
      },
      {
        "files": ["e2e/fake-driver/fake-driver.ts"],
        "maxCrap": 45,
        "reason": "This file has no wired coverage pipeline (fallow estimates 0% here), so CRAP is complexity-squared alone. The three flagged functions (#resolveOsVersion/#assertOsVersionAvailable, #beforeCall, compareVersions) are simple, deterministic script-interpretation/comparison helpers already reduced from a critical/high toError+resolveSpec pair (cyclomatic 11 and 9) down to cyclomatic 5-6 moderate; the daemon-level e2e flows exercise them on every run but that coverage isn't visible to this metric."
      }
    ]
  }
}
